#include "stm32f429xx.h"
#include <stdbool.h>
#include <stdint.h>


uint32_t maske = 0b11111111;

bool getButton(int n){

    return ((GPIOF->IDR & (1 << n)) == 0);
}


void setLEDs(bool* leds){


    //zuerst alle LEDs ausschalten
    GPIOD->BSRR = (maske << 16);


    for(int i = 0; i<9; i++)
    {
        if (leds[i] == true) 
        {
            GPIOD->BSRR |= (1<<i);
        }
    }
}

